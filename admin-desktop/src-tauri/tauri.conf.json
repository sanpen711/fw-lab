{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FW管理台",
  "version": "6.0.1",
  "identifier": "com.fwyanjiusuo.admin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1422",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FW管理台",
        "url": "index.html",
        "userAgent": "FWAdminDesktop/6.0.1",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' data: blob: https://*.supabase.co; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'",
      "capabilities": [
        {
          "identifier": "fw-admin-local",
          "description": "Allow the packaged FW management client to use the local application window.",
          "windows": ["main"],
          "permissions": ["core:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["../../src-tauri/icons/icon.ico"],
    "publisher": "FW研究所",
    "copyright": "Copyright © 2026 FW研究所",
    "shortDescription": "FW研究所管理员专用客户端",
    "longDescription": "用于处理举报、用户处罚、问题反馈和内容管理的独立 Windows 客户端。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "../../src-tauri/icons/icon.ico",
        "startMenuFolder": "FW研究所"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1OEQxM0UwQjkwNjhEMkUKUldRdWpRYTU0Qk9OWlJHNTNKcVhiVDdjNzM3eHI2eDlkQ0RYN01FZENlMFcrcW1CandOZU1qbjgK",
      "endpoints": [
        "https://fwyanjiusuo.com/download/admin-windows-updater.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
