{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "F.w 研究所",
  "version": "1.0.3",
  "identifier": "com.fwyanjiusuo.desktop",
  "build": {
    "frontendDist": "https://fwyanjiusuo.com/"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "F.w 研究所",
        "url": "https://fwyanjiusuo.com/square.html",
        "userAgent": "FWYanjiusuoDesktop/1.0.3",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "F.w 研究所",
    "copyright": "Copyright © 2026 F.w 研究所",
    "shortDescription": "F.w 研究所 Windows 客户端",
    "longDescription": "F.w 研究所 Windows 客户端，与网页端和手机端共用账号与数据。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "F.w 研究所"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1OEQxM0UwQjkwNjhEMkUKUldRdWpRYTU0Qk9OWlJHNTNKcVhiVDdjNzM3eHI2eDlkQ0RYN01FZENlMFcrcW1CandOZU1qbjgK",
      "endpoints": [
        "https://fwyanjiusuo.com/download/windows-updater.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
