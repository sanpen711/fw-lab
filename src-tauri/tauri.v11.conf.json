{
  "$schema": "https://schema.tauri.app/config/2",
  "version": "1.1.7",
  "build": {
    "beforeDevCommand": "npm --prefix desktop-v11 run dev",
    "beforeBuildCommand": "npm --prefix desktop-v11 run build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../desktop-v11/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "F.w 研究所",
        "url": "index.html",
        "userAgent": "FWYanjiusuoDesktop/1.1.7",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' data: blob: https://*.supabase.co; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "capabilities": [
        {
          "identifier": "fw-main-local-v11",
          "description": "Allow the packaged Windows 1.1.7 local frontend to use core window APIs.",
          "windows": ["main"],
          "permissions": ["core:default"]
        }
      ]
    }
  }
}
